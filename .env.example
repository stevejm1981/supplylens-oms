# ── Database ────────────────────────────────────────────────────────────────
# Local dev: SQLite (no value needed, prisma.config.ts points at prisma/dev.db)
# Production (Supabase): the pooled connection string for the app, and the
# direct connection string for running migrations.
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# ── API ─────────────────────────────────────────────────────────────────────
# Local dev falls back to demo-key-supplylens. Set a strong value in
# production; generated per-integration tokens work regardless.
# OMS_API_KEY="change-me-in-production"
